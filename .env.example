# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# --- Asset generation (scripts only; never shipped to the browser) ---
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
MESHY_API_KEY=

# --- Optional build-time settings (exposed to the browser) ---
# GitHub Pages project sites are served from /<repo>; leave empty for Cloudflare Pages / custom domains.
NEXT_PUBLIC_BASE_PATH=
# Site origin (e.g. https://you.github.io) so the share card gets an absolute URL; the deploy workflow sets it.
NEXT_PUBLIC_SITE_URL=
# Optional TURN relay for players behind strict NATs (comma-separated URLs). Leave empty to stay serverless.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
